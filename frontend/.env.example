# ChronoCraft Environment Variables Template
# Copy this file to .env.local to pre-configure API keys for the client:
# cp .env.example .env.local

# Google Gemini API Key (Primary Recommended)
# Get a free key at: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key (Optional)
# Get a key at: https://platform.openai.com/api-keys
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Default Provider: "gemini" or "openai"
NEXT_PUBLIC_DEFAULT_PROVIDER=gemini

# Default Models
NEXT_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini
