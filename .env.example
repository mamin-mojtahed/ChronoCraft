# ==============================================================================
# ChronoCraft Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRET API KEYS (RECOMMENDED FOR VERCEL DEPLOYMENT)
# ------------------------------------------------------------------------------
# When deploying on Vercel, define these in:
# Project Settings > Environment Variables
# These keys run ONLY in serverless functions and are NEVER exposed to client browsers.
#
# Google Gemini API Key (Primary Recommended - Free Tier available):
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_secret_gemini_api_key_here

# OpenAI API Key (Optional Alternative):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_secret_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE / STATIC EXPORT KEYS (ONLY FOR GITHUB PAGES / PURE STATIC SITES)
# ------------------------------------------------------------------------------
# WARNING: Any variable prefixed with NEXT_PUBLIC_ is bundled into client JavaScript!
# Only use these if you are self-hosting on GitHub Pages without a backend server.
# NEXT_PUBLIC_GEMINI_API_KEY=your_public_client_key_here
# NEXT_PUBLIC_OPENAI_API_KEY=your_public_client_key_here

# ------------------------------------------------------------------------------
# 3. DEFAULT PREFERENCES
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_PROVIDER=gemini
NEXT_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini
